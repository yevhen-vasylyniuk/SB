              "pm.test(\"INSERT збережено для щойно створеної кімнати\", function () {",
              "    const history = pm.response.json();",
              "    const roomId = pm.collectionVariables.get(\"roomId\");",
              "    const inserted = history.find(item =>",
              "        item.tableName === \"rooms\" &&",
              "        String(item.recordId) === roomId &&",
              "        item.action === \"INSERT\"",
              "    );",
              "    pm.expect(inserted).to.exist;",
              "    pm.expect(inserted.oldData).to.be.null;",
              "    pm.expect(inserted.newData.name).to.eql(pm.collectionVariables.get(\"roomName\"));",
              "    pm.expect(inserted.newData.rent).to.eql(50000);",
              "});"
            ]
          }
        }
