      "name": "Rooms - INSERT",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"{{roomName}}\",\n  \"type\": \"base\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "http://localhost:3000/rooms",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "3000",
          "path": [
            "rooms"
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Нова назва для кожного запуску; не залежимо від того, чи попередній запуск завершився.",
              "const suffix = Date.now().toString(36) + \"_\" + Math.random().toString(36).slice(2, 10);",
              "const roomName = \"QA Test Room \" + suffix;",
              "pm.collectionVariables.unset(\"roomId\");",
              "pm.collectionVariables.set(\"roomName\", roomName);",
              "pm.collectionVariables.set(\"updatedRoomName\", roomName + \" Updated\");"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Створення кімнати повертає 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test(\"Створена кімната має ID і правильні поля\", function () {",
              "    const data = pm.response.json();",
              "    pm.expect(data.id).to.exist;",
              "    pm.expect(String(data.id)).to.match(/^\\d+$/);",
              "    pm.expect(data.name).to.eql(pm.collectionVariables.get(\"roomName\"));",
              "    pm.expect(data.type).to.eql(\"base\");",
              "    pm.expect(data.rent).to.eql(50000);",
              "});",
              "",
              "if (pm.response.code === 201) {",
              "    const data = pm.response.json();",
              "    if (data.id !== undefined && data.id !== null) {",
              "        pm.collectionVariables.set(\"roomId\", String(data.id));",
              "    }",
              "}"
            ]
          }
        }
      ]
    },
