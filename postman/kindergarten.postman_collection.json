  "item": [
    {
      "name": "00 — Login admin (після інтеграції JWT)",
      "description": "Поточний index.js не має /auth/login. Запускайте після злиття PR авторизації. Для запуску старого dev без JWT пропускайте цю папку.",
      "item": [
        {
          "name": "Login admin — POST /auth/login → {{token}}",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"{{adminLogin}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/auth/login",
            "description": "Запускайте ПЕРШИМ після інтеграції PR авторизації. Пароль береться із локального environment, не з колекції. Відповідь JWT зберігається у змінній оточення token."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set('token', '');",
                  "if (!pm.environment.get('adminPassword')) {",
                  "    console.warn('Заповніть adminPassword у локальному Postman Environment (не експортуйте його у Git).');",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200 — admin login', () => pm.response.to.have.status(200));",
                  "pm.test('JWT отримано і збережено у {{token}}', () => {",
                  "    const data = pm.response.json();",
                  "    const token = data.token || data.accessToken || data.jwt || (data.data && (data.data.token || data.data.accessToken));",
                  "    pm.expect(token, 'Очікував поле token або accessToken у відповіді').to.be.a('string').and.not.empty;",
                  "    pm.expect(token.split('.').length, 'JWT повинен містити 3 сегменти').to.eql(3);",
                  "    pm.environment.set('token', token);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
