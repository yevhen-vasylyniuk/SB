# Приклад змінних середовища. Скопіюйте у .env (або виконайте npm run setup)
# і впишіть власні значення. Файл .env у Git не додається.

# Порт сервера
PORT=3000

# Пароль користувача admin, який створюється при першому запуску (мінімум 12 символів).
# Зміна пароля тут не впливає на вже створеного адміна: потрібно npm run db:reset.
ADMIN_PASSWORD=

# Секрет для підпису JWT-токенів (мінімум 32 символи)
JWT_SECRET=

# Шлях до файлу бази (необов'язково, типово kindergarten.db)
# DB_PATH=kindergarten.db
